GEMINI_API_KEY=replace_with_your_gemini_api_key
OLLAMA_BASE_URL=http://localhost:11434
POSTGRES_URL=postgresql://postgres:replace_with_a_local_password@localhost:5432/intel_db
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
SLACK_WEBHOOK_URL=leave_this_blank_for_now

# Postgres credentials used by docker-compose.yml (do NOT commit real values)
POSTGRES_DB=intel_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_a_local_password

# Observability (Pydantic Logfire) — safe to leave blank; falls back to console-only spans
LOGFIRE_TOKEN=

# Set to "true" in deployed environments without a local Ollama instance
# (see DEPLOYMENT.md) — falls back to Gemini Flash for the Summarizer + RAG chat
USE_HOSTED_LLM=false
